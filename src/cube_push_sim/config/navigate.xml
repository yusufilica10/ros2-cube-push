<root BTCPP_format="4" main_tree_to_execute="CubeNavigate">
  <BehaviorTree ID="CubeNavigate">
    <RecoveryNode number_of_retries="2" name="NavigationWithCostmapRecovery">
      <PipelineSequence>
        <RateController hz="0.5">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}" error_msg="{compute_path_error_msg}"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" error_code_id="{follow_path_error_code}" error_msg="{follow_path_error_msg}"/>
      </PipelineSequence>
      <Sequence>
        <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
